# ---------------------------------------------------------------------------
# TouchGrass — environment template
#
# Copy this file before running the app:
#   npm run setup        # writes apps/web/.env.local and ./.env
#
# ./.env                 is read by docker compose (local model runtime)
# apps/web/.env.local    is read by Next.js (application runtime)
#
# Never commit a file with real values. Only this template is tracked.
# Every variable below is parsed and validated by packages/shared/src/env.ts —
# an unset or malformed value fails fast at startup instead of at request time.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Open-weight model -----------------------------------------------------
# MODEL_PROVIDER selects an adapter from packages/ai. The application never
# imports an adapter directly, so swapping runtimes is a config change.
#   ollama             local / self-hosted Ollama daemon (default for dev)
#   openai-compatible  any OpenAI-compatible server (vLLM, llama.cpp, TGI)
MODEL_PROVIDER=ollama

# The open-weight model itself. Must be pulled into the runtime before use:
#   npm run ai:pull
MODEL_NAME=gemma3:4b

# Ollama default: http://localhost:11434
# OpenAI-compatible default: http://localhost:8000/v1
MODEL_BASE_URL=http://localhost:11434

# Only needed by gateways that require a bearer token. Local Ollama ignores it.
MODEL_API_KEY=

# Generation + transport tuning. Game Master turns sit in a player's critical
# path, so the timeout is deliberately short and retries are bounded.
MODEL_REQUEST_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2
MODEL_TEMPERATURE=0.8

# The Game Master is built on Mastra (@mastra/core). Mastra ships anonymous usage
# telemetry that is on by default, and its telemetry code can be loaded on the
# path the Game Master uses. In an empirical Game Master test no telemetry
# request was observed; that was not a packet-level or network-wide proof that
# none can ever be sent. This variable is Mastra's own switch to turn it off.
MASTRA_TELEMETRY_DISABLED=1

# Persistent server (`npm run server:dev`) — session snapshots in MongoDB.
# Only that command uses these, and it reads them from the process environment:
# it does not load this file, so set them in your shell, for example
#   MONGODB_URI=mongodb://127.0.0.1:27017 npm run server:dev
# A local MongoDB is enough. Nothing else needs a database. Never put real
# credentials in a committed file.
MONGODB_URI=
# Optional. Defaults: database "touchgrass", collection "sessions".
MONGODB_DATABASE=
MONGODB_COLLECTION=

# Multi-session server (`npm run sessions:dev`). Like the persistent server, it
# reads these from the process environment and does not load this file.
# When a session with no connection may be released from memory, in milliseconds.
# Defaults: 30 minutes, 0 once its game is over, and a sweep every minute.
SESSION_IDLE_MS=
SESSION_FINISHED_IDLE_MS=
SESSION_SWEEP_MS=
# The Game Master for that server. Off unless set to true: no model is asked and
# no model runtime is needed. When on, it uses the MODEL_* settings above.
GAME_MASTER_ENABLED=
# How long one Game Master turn may wait for the model. Default 20000.
GAME_MASTER_TIMEOUT_MS=
# Read-only tools the Game Master may use, comma separated. Default none.
# Known tools: game_history, game_rules.
GAME_MASTER_TOOLS=

# Error reporting for that server. Off unless SENTRY_ENABLED is true, and then
# SENTRY_DSN is required. With it off the Sentry SDK is not loaded at all.
# Never commit a real DSN.
SENTRY_ENABLED=
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Opt-in live evaluation of the Game Master against the real model runtime:
#   GAME_MASTER_LIVE_EVAL=1 npm run ai:live

# ---------------------------------------------------------------------------
# Playing from the website (`npm run dev`). The site creates games on the game
# server and players' browsers connect to it. Leave these blank and the site
# still shows the catalogue, and says that playing is not set up.
# The site also needs ADMIN_TOKEN (below) set to the game server's value.
# ---------------------------------------------------------------------------

# Where the website's own server reaches the game server.
# For a local game server: http://127.0.0.1:3001
GAME_SERVER_URL=
# Where players' browsers reach it. Blank means GAME_SERVER_URL as ws:// (or
# wss://). Set it when phones need a different address, e.g. ws://192.168.1.20:3001
# `same-origin` means the address the site itself is opened at, for a host that
# puts both behind one domain and routes /sessions/ to the game server.
GAME_SERVER_WS_URL=

# ---------------------------------------------------------------------------
# Production game server (`npm run start:server`, or the image built from
# Dockerfile.server). It reads its environment and does not load this file.
# MONGODB_URI above is the only variable it requires. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# The address and port to listen on. The code defaults to 127.0.0.1; the image
# sets 0.0.0.0. Port default 3001.
SERVER_HOST=
SERVER_PORT=

# SECRET. The bearer value for the admin endpoints (create a session, save,
# metrics), 32 to 256 characters. Without it those endpoints do not exist, and no session
# can be created. Generate one, and never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# SECRET. Base64 of at least 32 random bytes. Player tokens are worked out from
# it, so it must stay THE SAME across restarts and deployments for a player to
# resume after one. Change it and every player token stops working. Without it,
# a new key is made at every start, so every restart ends every player token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_TOKEN_KEY=

# Optional tuning. Defaults: 5000, 30000 (0 turns the heartbeat off), 25000.
MONGODB_TIMEOUT_MS=
WS_HEARTBEAT_MS=
SHUTDOWN_TIMEOUT_MS=
# How often every loaded game is told the time, so that rounds end and games
# finish without anyone having to send a message. Default 1000. 0 turns it off.
SESSION_TICK_MS=

# ---------------------------------------------------------------------------
# Not used. Redis is not built: nothing in the codebase reads this. It is kept
# because the shared environment schema still accepts it. Leave it blank.
# ---------------------------------------------------------------------------
REDIS_URL=
