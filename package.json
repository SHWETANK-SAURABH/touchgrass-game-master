{
  "name": "touchgrass",
  "version": "0.1.0",
  "private": true,
  "description": "TouchGrass — an open-weight AI Game Master for real-world outdoor games.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "dev": "npm run dev --workspace @touchgrass/web",
    "build": "npm run build --workspace @touchgrass/web",
    "start": "npm run start --workspace @touchgrass/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "ai:up": "docker compose up -d ollama",
    "ai:pull": "docker compose run --rm model-init",
    "ai:logs": "docker compose logs -f ollama",
    "ai:down": "docker compose down",
    "ai:live": "vitest run --config vitest.live.config.mts",
    "realtime:dev": "tsx packages/realtime/src/dev.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
